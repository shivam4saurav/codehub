{
  "name": "@codehub/server",
  "version": "1.0.0",
  "private": true,
  "description": "CodeHub API - Express + MongoDB backend",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "smoke": "node scripts/smoke.js",
    "seed": "node scripts/seedProblems.js",
    "sync:problems": "node scripts/runProblemSync.js",
    "sync:contests": "node scripts/runContestSync.js"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "axios": "1.20.0",
    "bcryptjs": "3.0.3",
    "compression": "1.8.2",
    "cookie-parser": "1.4.7",
    "cors": "2.8.6",
    "dayjs": "1.11.23",
    "dotenv": "18.0.3",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "9.10.2",
    "morgan": "1.12.1",
    "node-cache": "5.1.2",
    "node-cron": "4.6.0",
    "nodemailer": "10.0.10",
    "satori": "^0.33.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "cross-env": "10.1.0",
    "eslint": "^9.39.5",
    "globals": "^17.12.0",
    "jest": "30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "3.1.14",
    "supertest": "7.3.0"
  }
}
