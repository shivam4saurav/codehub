# ---------------------------------------------------------------------------
# CodeHub API configuration
# Copy to server/.env and fill in your own values. Never commit server/.env.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Public URL of the React app (used for CORS, share links and email links)
CLIENT_URL=http://localhost:5173

# Public URL of this API (used for absolute share-card / OG image URLs)
SERVER_URL=http://localhost:5000

# --- Database --------------------------------------------------------------
# Local:  mongodb://127.0.0.1:27017/codehub
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/codehub?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/codehub

# --- Auth ------------------------------------------------------------------
# Use two DIFFERENT long random strings (min 32 chars each).
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret-min-32-chars
JWT_REFRESH_SECRET=replace-with-a-different-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cookie behaviour. Set COOKIE_SECURE=true and COOKIE_SAMESITE=none in
# production when the API and client live on different domains (Render + Vercel).
COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- Third-party sources ---------------------------------------------------
# Codeforces needs no key. Keep the interval >= 2000ms to respect their limits.
CODEFORCES_API_BASE=https://codeforces.com/api
CODEFORCES_MIN_INTERVAL_MS=2100

# LeetCode / CodeChef are unofficial endpoints - always snapshot-backed.
LEETCODE_GRAPHQL_URL=https://leetcode.com/graphql
CODECHEF_PROFILE_BASE=https://www.codechef.com/users

# Optional: clist.by aggregator for LeetCode + CodeChef contests.
# Leave blank to run without it (cached / Codeforces-only contest data).
# Key page (requires login): https://clist.by/api/v4/doc/
CLIST_API_BASE=https://clist.by/api/v4
CLIST_USERNAME=
CLIST_API_KEY=

# --- Email (reminders) -----------------------------------------------------
# Leave SMTP_HOST blank in development: reminder emails are logged to the
# console instead of being sent, so the whole flow stays testable.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="CodeHub <no-reply@codehub.local>"

# --- Jobs / caching --------------------------------------------------------
ENABLE_CRON=true
PROBLEM_SYNC_CRON=0 */6 * * *
CONTEST_SYNC_CRON=*/15 * * * *
REMINDER_CRON=* * * * *
CACHE_TTL_SECONDS=300
PROFILE_REFRESH_COOLDOWN_SECONDS=120
