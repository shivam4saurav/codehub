# ---------------------------------------------------------------------------
# CodeHub client configuration
# Copy to client/.env. Everything here ships to the browser - no secrets.
# ---------------------------------------------------------------------------

# Base URL of the CodeHub API.
# Local dev can leave this as-is: Vite proxies /api to the port below.
VITE_API_URL=http://localhost:5000

# Port the Vite dev server should use.
VITE_PORT=5173
